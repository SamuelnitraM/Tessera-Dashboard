{
  "$schema": "../node_modules/@tessera/module-sdk/manifest.schema.json",
  "id": "demo.pense-bete",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": { "fr": "Pense-bête", "en": "To-do" },
  "description": {
    "fr": "Une petite liste de choses à faire, enregistrée avec le bloc.",
    "en": "A small to-do list, saved with the block."
  },
  "author": "Tessera Dashboard",
  "widgets": [
    {
      "type": "liste",
      "name": { "fr": "Pense-bête", "en": "To-do" },
      "description": { "fr": "Liste de choses à faire.", "en": "To-do list." },
      "icon": "list-checks",
      "defaultSize": { "w": 5, "h": 5 },
      "minSize": { "w": 3, "h": 3 },
      "settings": [
        {
          "key": "hideDone",
          "type": "boolean",
          "label": { "fr": "Masquer les tâches faites", "en": "Hide done tasks" },
          "default": false
        }
      ]
    }
  ]
}
