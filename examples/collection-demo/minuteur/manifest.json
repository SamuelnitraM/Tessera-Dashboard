{
  "$schema": "../node_modules/@tessera/module-sdk/manifest.schema.json",
  "id": "demo.minuteur",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": { "fr": "Minuteur", "en": "Timer" },
  "description": {
    "fr": "Un compte à rebours qui prévient quand il arrive à zéro.",
    "en": "A countdown that lets you know when it reaches zero."
  },
  "author": "Tessera Dashboard",
  "permissions": ["notifications"],
  "widgets": [
    {
      "type": "minuteur",
      "name": { "fr": "Minuteur", "en": "Timer" },
      "description": {
        "fr": "Compte à rebours avec notification.",
        "en": "Countdown with a notification."
      },
      "icon": "timer",
      "defaultSize": { "w": 4, "h": 3 },
      "minSize": { "w": 3, "h": 2 },
      "settings": [
        {
          "key": "minutes",
          "type": "number",
          "label": { "fr": "Durée (minutes)", "en": "Duration (minutes)" },
          "default": 5,
          "min": 1,
          "max": 180
        }
      ]
    }
  ]
}
