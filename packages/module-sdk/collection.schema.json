{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SamuelnitraM/Tessera-Dashboard/packages/module-sdk/collection.schema.json",
  "title": "Collection de modules Tessera Dashboard / Tessera Dashboard module collection",
  "description": "collection.json : plusieurs modules installés en une fois. Référence : docs/modules/fr/collections.md — Several modules installed at once. Reference: docs/modules/en/collections.md",
  "type": "object",
  "required": ["id", "version", "name", "description", "author", "modules"],
  "additionalProperties": true,
  "definitions": {
    "localizedText": {
      "type": "object",
      "properties": {
        "fr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Identifiant de la collection, ex. « auteur.collection ». — Collection id.",
      "$ref": "#/definitions/id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": { "$ref": "#/definitions/localizedText" },
    "description": { "$ref": "#/definitions/localizedText" },
    "author": { "type": "string", "minLength": 1 },
    "modules": {
      "description": "Identifiants des modules de la collection (30 au maximum). — Ids of the modules in the collection.",
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "allOf": [{ "$ref": "#/definitions/id" }, { "not": { "pattern": "^tessera\\." } }]
      }
    }
  }
}
