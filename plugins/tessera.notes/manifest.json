{
  "id": "tessera.notes",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": {
    "fr": "Bloc-notes",
    "en": "Notepad"
  },
  "description": {
    "fr": "Des notes en texte brut, Markdown ou texte riche, enregistrées comme fichiers sur ton PC.",
    "en": "Notes in plain text, Markdown or rich text, saved as files on your PC."
  },
  "author": "Tessera Dashboard",
  "category": "productivity",
  "permissions": ["files"],
  "files": {
    "folder": "Notes"
  },
  "widgets": [
    {
      "type": "notes",
      "name": {
        "fr": "Bloc-notes",
        "en": "Notepad"
      },
      "description": {
        "fr": "Plusieurs notes en texte brut, Markdown ou texte riche.",
        "en": "Several notes in plain text, Markdown or rich text."
      },
      "icon": "notebook-pen",
      "defaultSize": {
        "w": 10,
        "h": 6
      },
      "minSize": {
        "w": 5,
        "h": 4
      },
      "settings": [
        {
          "key": "autosave",
          "type": "boolean",
          "label": {
            "fr": "Enregistrement automatique",
            "en": "Autosave"
          },
          "default": true
        },
        {
          "key": "defaultFormat",
          "type": "select",
          "label": {
            "fr": "Format des nouvelles notes",
            "en": "Format of new notes"
          },
          "default": "markdown",
          "options": [
            {
              "value": "plain",
              "label": {
                "fr": "Texte brut",
                "en": "Plain text"
              }
            },
            {
              "value": "markdown",
              "label": {
                "fr": "Markdown",
                "en": "Markdown"
              }
            },
            {
              "value": "rich",
              "label": {
                "fr": "Texte riche",
                "en": "Rich text"
              }
            }
          ]
        },
        {
          "key": "fontSize",
          "type": "number",
          "label": {
            "fr": "Taille du texte (pixels)",
            "en": "Text size (pixels)"
          },
          "default": 15,
          "min": 11,
          "max": 28,
          "step": 1
        },
        {
          "key": "showList",
          "type": "boolean",
          "label": {
            "fr": "Afficher la liste des notes (si le widget est assez large)",
            "en": "Show the list of notes (when the widget is wide enough)"
          },
          "default": true
        }
      ]
    }
  ]
}
