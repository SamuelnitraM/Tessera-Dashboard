{
  "id": "tessera.desktop",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": {
    "fr": "Application installée",
    "en": "Installed app"
  },
  "description": {
    "fr": "Affiche la fenêtre d’un programme installé sur ton PC (Discord, Obsidian…) dans un bloc. L’application garde sa connexion et ses notifications.",
    "en": "Shows the window of a program installed on your PC (Discord, Obsidian…) in a block. The app keeps its sign-in and notifications."
  },
  "author": "Tessera Dashboard",
  "category": "apps",
  "permissions": ["apps"],
  "widgets": [
    {
      "type": "app",
      "name": {
        "fr": "Application installée",
        "en": "Installed app"
      },
      "description": {
        "fr": "Un programme de ton PC dans un bloc.",
        "en": "A program from your PC in a block."
      },
      "icon": "app-window",
      "defaultSize": {
        "w": 12,
        "h": 8
      },
      "minSize": {
        "w": 4,
        "h": 3
      },
      "settings": [
        {
          "key": "showHeader",
          "type": "boolean",
          "label": {
            "fr": "Afficher la barre du bloc (nom de l’application)",
            "en": "Show the block bar (app name)"
          },
          "default": true
        },
        {
          "key": "openFiles",
          "type": "boolean",
          "label": {
            "fr": "Prioritaire pour ouvrir les fichiers et les pages web",
            "en": "Preferred for opening files and web pages"
          },
          "default": false
        },
        {
          "key": "fullScreen",
          "type": "select",
          "label": {
            "fr": "Plein écran",
            "en": "Full screen"
          },
          "default": "screen",
          "options": [
            {
              "value": "screen",
              "label": {
                "fr": "Tout l’écran",
                "en": "Whole screen"
              }
            },
            {
              "value": "block",
              "label": {
                "fr": "Dans le bloc",
                "en": "In the block"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "browser",
      "name": {
        "fr": "Navigateur",
        "en": "Browser"
      },
      "description": {
        "fr": "Ton navigateur (Brave, Chrome, Edge, Firefox…) dans un bloc, avec ses onglets.",
        "en": "Your browser (Brave, Chrome, Edge, Firefox…) in a block, with its tabs."
      },
      "icon": "globe",
      "defaultSize": {
        "w": 12,
        "h": 8
      },
      "minSize": {
        "w": 4,
        "h": 3
      },
      "settings": [
        {
          "key": "showHeader",
          "type": "boolean",
          "label": {
            "fr": "Afficher la barre du bloc (nom de l’application)",
            "en": "Show the block bar (app name)"
          },
          "default": true
        },
        {
          "key": "openFiles",
          "type": "boolean",
          "label": {
            "fr": "Prioritaire pour ouvrir les fichiers et les pages web",
            "en": "Preferred for opening files and web pages"
          },
          "default": false
        },
        {
          "key": "fullScreen",
          "type": "select",
          "label": {
            "fr": "Plein écran",
            "en": "Full screen"
          },
          "default": "screen",
          "options": [
            {
              "value": "screen",
              "label": {
                "fr": "Tout l’écran",
                "en": "Whole screen"
              }
            },
            {
              "value": "block",
              "label": {
                "fr": "Dans le bloc",
                "en": "In the block"
              }
            }
          ]
        }
      ]
    }
  ]
}
