{
  "id": "tessera.clock",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": { "fr": "Horloge", "en": "Clock" },
  "description": {
    "fr": "Affiche l’heure et la date du jour.",
    "en": "Shows the current time and date."
  },
  "author": "Tessera Dashboard",
  "category": "tools",
  "widgets": [
    {
      "type": "clock",
      "name": { "fr": "Horloge", "en": "Clock" },
      "description": { "fr": "L’heure et la date du jour.", "en": "The current time and date." },
      "icon": "clock",
      "defaultSize": { "w": 6, "h": 3 },
      "minSize": { "w": 3, "h": 2 },
      "settings": [
        {
          "key": "showDate",
          "type": "boolean",
          "label": { "fr": "Afficher la date", "en": "Show date" },
          "default": true
        },
        {
          "key": "showSeconds",
          "type": "boolean",
          "label": { "fr": "Afficher les secondes", "en": "Show seconds" },
          "default": false
        },
        {
          "key": "hourCycle",
          "type": "select",
          "label": { "fr": "Format de l’heure", "en": "Time format" },
          "default": "auto",
          "options": [
            { "value": "auto", "label": { "fr": "Selon la langue", "en": "Based on language" } },
            { "value": "h23", "label": { "fr": "24 heures", "en": "24-hour" } },
            { "value": "h12", "label": { "fr": "12 heures (AM/PM)", "en": "12-hour (AM/PM)" } }
          ]
        }
      ]
    }
  ]
}
