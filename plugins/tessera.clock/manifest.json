{
  "id": "tessera.clock",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": {
    "fr": "Horloge",
    "en": "Clock"
  },
  "description": {
    "fr": "L’heure et la date, le calendrier du mois et les horloges du monde.",
    "en": "The time and date, the month calendar and world clocks."
  },
  "author": "Tessera Dashboard",
  "category": "tools",
  "widgets": [
    {
      "type": "clock",
      "name": {
        "fr": "Horloge",
        "en": "Clock"
      },
      "description": {
        "fr": "L’heure et la date, avec le calendrier du mois et l’heure d’autres villes si tu veux.",
        "en": "The time and date, with the month calendar and the time in other cities if you like."
      },
      "icon": "clock",
      "defaultSize": {
        "w": 6,
        "h": 3
      },
      "minSize": {
        "w": 3,
        "h": 2
      },
      "settings": [
        {
          "key": "showTime",
          "type": "boolean",
          "label": {
            "fr": "Afficher l’heure",
            "en": "Show time"
          },
          "default": true
        },
        {
          "key": "showDate",
          "type": "boolean",
          "label": {
            "fr": "Afficher la date",
            "en": "Show date"
          },
          "default": true
        },
        {
          "key": "showSeconds",
          "type": "boolean",
          "label": {
            "fr": "Afficher les secondes",
            "en": "Show seconds"
          },
          "default": false
        },
        {
          "key": "hourCycle",
          "type": "select",
          "label": {
            "fr": "Format de l’heure",
            "en": "Time format"
          },
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": {
                "fr": "Selon la langue",
                "en": "Based on language"
              }
            },
            {
              "value": "h23",
              "label": {
                "fr": "24 heures",
                "en": "24-hour"
              }
            },
            {
              "value": "h12",
              "label": {
                "fr": "12 heures (AM/PM)",
                "en": "12-hour (AM/PM)"
              }
            }
          ]
        },
        {
          "key": "showCalendar",
          "type": "boolean",
          "label": {
            "fr": "Afficher le calendrier du mois",
            "en": "Show month calendar"
          },
          "default": false
        },
        {
          "key": "showWorldClocks",
          "type": "boolean",
          "label": {
            "fr": "Afficher les horloges du monde",
            "en": "Show world clocks"
          },
          "default": false
        }
      ]
    }
  ]
}
