{
  "id": "tessera.web",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": {
    "fr": "Application web",
    "en": "Web app"
  },
  "description": {
    "fr": "Affiche une de tes applications web (Discord…) ou n’importe quel site dans un bloc.",
    "en": "Shows one of your web apps (Discord…) or any website in a block."
  },
  "author": "Tessera Dashboard",
  "permissions": ["web"],
  "widgets": [
    {
      "type": "web",
      "name": {
        "fr": "Application web",
        "en": "Web app"
      },
      "description": {
        "fr": "Une application web ou un site dans un bloc.",
        "en": "A web app or website in a block."
      },
      "icon": "globe",
      "defaultSize": {
        "w": 8,
        "h": 6
      },
      "minSize": {
        "w": 3,
        "h": 2
      },
      "settings": [
        {
          "key": "zoom",
          "type": "select",
          "label": {
            "fr": "Zoom",
            "en": "Zoom"
          },
          "default": "100",
          "options": [
            {
              "value": "50",
              "label": {
                "fr": "50 %",
                "en": "50%"
              }
            },
            {
              "value": "67",
              "label": {
                "fr": "67 %",
                "en": "67%"
              }
            },
            {
              "value": "80",
              "label": {
                "fr": "80 %",
                "en": "80%"
              }
            },
            {
              "value": "90",
              "label": {
                "fr": "90 %",
                "en": "90%"
              }
            },
            {
              "value": "100",
              "label": {
                "fr": "100 %",
                "en": "100%"
              }
            },
            {
              "value": "110",
              "label": {
                "fr": "110 %",
                "en": "110%"
              }
            },
            {
              "value": "125",
              "label": {
                "fr": "125 %",
                "en": "125%"
              }
            },
            {
              "value": "150",
              "label": {
                "fr": "150 %",
                "en": "150%"
              }
            }
          ]
        },
        {
          "key": "refreshMinutes",
          "type": "number",
          "label": {
            "fr": "Actualiser automatiquement (minutes, 0 = jamais)",
            "en": "Auto refresh (minutes, 0 = never)"
          },
          "default": 0,
          "min": 0,
          "max": 1440,
          "step": 1
        },
        {
          "key": "showToolbar",
          "type": "boolean",
          "label": {
            "fr": "Afficher la barre de navigation",
            "en": "Show the navigation bar"
          },
          "default": true
        }
      ]
    }
  ]
}
