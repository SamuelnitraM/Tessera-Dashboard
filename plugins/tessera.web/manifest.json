{
  "id": "tessera.web",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": { "fr": "Page web", "en": "Web page" },
  "description": {
    "fr": "Affiche un site web ou une de tes applications (Discord…) dans une case de la grille.",
    "en": "Shows a website or one of your apps (Discord…) in a grid tile."
  },
  "author": "Tessera Dashboard",
  "permissions": ["web"],
  "widgets": [
    {
      "type": "web",
      "name": { "fr": "Page web", "en": "Web page" },
      "description": {
        "fr": "Un site ou une application web dans une case.",
        "en": "A website or web app in a tile."
      },
      "icon": "globe",
      "defaultSize": { "w": 8, "h": 6 },
      "minSize": { "w": 3, "h": 2 },
      "settings": [
        {
          "key": "zoom",
          "type": "select",
          "label": { "fr": "Zoom", "en": "Zoom" },
          "default": "100",
          "options": [
            { "value": "50", "label": { "fr": "50 %", "en": "50%" } },
            { "value": "67", "label": { "fr": "67 %", "en": "67%" } },
            { "value": "80", "label": { "fr": "80 %", "en": "80%" } },
            { "value": "90", "label": { "fr": "90 %", "en": "90%" } },
            { "value": "100", "label": { "fr": "100 %", "en": "100%" } },
            { "value": "110", "label": { "fr": "110 %", "en": "110%" } },
            { "value": "125", "label": { "fr": "125 %", "en": "125%" } },
            { "value": "150", "label": { "fr": "150 %", "en": "150%" } }
          ]
        },
        {
          "key": "refreshMinutes",
          "type": "number",
          "label": {
            "fr": "Actualiser automatiquement (minutes, 0 = jamais)",
            "en": "Auto refresh (minutes, 0 = never)"
          },
          "default": 0,
          "min": 0,
          "max": 1440,
          "step": 1
        },
        {
          "key": "showToolbar",
          "type": "boolean",
          "label": { "fr": "Afficher la barre de navigation", "en": "Show the navigation bar" },
          "default": true
        }
      ]
    }
  ]
}
