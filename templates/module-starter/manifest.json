{
  "$schema": "./node_modules/@tessera/module-sdk/manifest.schema.json",
  "id": "auteur.mon-module",
  "version": "1.0.0",
  "apiVersion": 1,
  "name": { "fr": "Mon module", "en": "My module" },
  "description": { "fr": "Un compteur, pour commencer.", "en": "A counter, to get started." },
  "author": "Ton nom",
  "widgets": [
    {
      "type": "compteur",
      "name": { "fr": "Compteur", "en": "Counter" },
      "description": { "fr": "Un compteur à incrémenter.", "en": "A counter to increment." },
      "icon": "plus-circle",
      "defaultSize": { "w": 4, "h": 3 },
      "minSize": { "w": 2, "h": 2 },
      "settings": [
        {
          "key": "step",
          "type": "number",
          "label": { "fr": "Pas", "en": "Step" },
          "default": 1,
          "min": 1,
          "max": 100
        }
      ]
    }
  ]
}
